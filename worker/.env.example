# Copier en .env (chmod 600 .env) puis remplir. Ne jamais commiter .env.
# Identifiant (UUID) de l'application, affiché dans le Control Panel d'Enable Banking.
EB_APP_ID=
# Chemin du fichier .pem téléchargé à la création de l'application (permissions 600).
EB_PRIVATE_KEY_FILE=/opt/budget/secrets/enablebanking.pem
# Mot de passe que tu inventes (30+ caractères aléatoires) : le même que dans l'app.
APP_TOKEN=
# Adresse de l'app (GitHub Pages) et son origine (sans chemin), pour la page de retour et le CORS.
APP_URL=https://figtitou-svg.github.io/budget/
APP_ORIGIN=https://figtitou-svg.github.io
# Facultatif
#MIN_REFRESH_MINUTES=360
#ASPSP_NAME=Société Générale
#ACCOUNT_TAGS=
#DATA_FILE=/var/lib/budget-sync/state.json
#HOST=127.0.0.1
#PORT=8787
